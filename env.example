# Celebré environment template — placeholders only, no real secrets.
# Copy to `.env` (git-ignored) and fill in your own values.
#
# Rule of thumb: secret = server side only. Anything named VITE_* is bundled
# into the browser build, so keys must NEVER use a VITE_ prefix.

# --- Convex (frontend + auth) -----------------------------------------------
# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# --- Gemini backend (server/, started with `bun run server`) ----------------

# Google AI Studio API key — SERVER SIDE ONLY.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Leave blank to auto-discover a model available to your API
# key; to pin one, set an explicit id such as:
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=

# Port the Express server listens on
PORT=8787

# Origins allowed to call the API (comma separated), or * for any origin
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Request and rate limits
AI_BODY_LIMIT=32kb
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
GEMINI_TIMEOUT_MS=60000

# Frontend: base URL the browser uses for AI requests.
# Leave blank to use the default http://localhost:8787/api/gemini (or set
# /api/gemini when the same Express server also serves the built frontend).
# This is a plain URL — no secret ever belongs in a VITE_ variable.
VITE_AI_API_BASE=
